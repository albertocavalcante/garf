# Command Line Reference
# https://bazel.build/reference/command-line-reference

common --enable_platform_specific_config

# Experimental Flags
common --experimental_isolated_extension_usages

# Incompatible Flags
common --incompatible_use_plus_in_repo_names

# Hermetic C++ Toolchain
build --action_env BAZEL_DO_NOT_DETECT_CPP_TOOLCHAIN=1

# Pure Go Workaround
# https://github.com/bazel-contrib/rules_go/issues/4154#issuecomment-2433739889
build --define=gotags=purego

# Startup Options
# https://bazel.build/reference/command-line-reference#startup-options
# startup --server_javabase=/usr/lib/jvm/java-21-openjdk-amd64

# Toolchain Debugging
# https://bazel.build/extending/toolchains#debugging-toolchains
build:debug --toolchain_resolution_debug=".*"
